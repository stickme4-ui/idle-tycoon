# ---- Broker ----
# sim    = demo mode with a simulated market (no account needed)
# alpaca = a real Alpaca account (paper or live)
BROKER=sim

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper money (DEFAULT). false = REAL money.
ALPACA_PAPER=true
# iex = free (partial volume). sip = full market data (paid Alpaca plan, recommended for live)
ALPACA_DATA_FEED=iex

# ---- Claude ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Safety ----
# Auto mode with REAL money stays locked unless this is true.
ALLOW_LIVE_AUTO=false

# ---- Server ----
HOST=127.0.0.1
PORT=8000
# demo speed: simulated seconds per real second
SIM_SPEED=60
